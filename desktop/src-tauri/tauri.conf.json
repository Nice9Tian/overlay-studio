{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overlay Studio",
  "version": "1.2.0",
  "identifier": "com.overlaystudio.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "publisher": "一页枝鸥",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  }
}
